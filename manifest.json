{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.16.0",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://streeteasy.com/*",
    "https://www.streeteasy.com/*",
    "https://www.insurent.com/*",
    "https://insurent.com/*",
    "https://theguarantors.com/*",
    "https://www.theguarantors.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_extName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://streeteasy.com/*",
        "https://www.streeteasy.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
